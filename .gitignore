# Database dumps
*.dump
*.sql.gz
backups/

# Deploy state written on the server by scripts/deploy.sh — records the running
# and previous build so scripts/rollback.sh has something to point at. Host
# state, not source (audit TEST-D1).
.deploy-state/

# AI / Vector stores (if any local cache)
.embeddings-cache/

# Misc
.cache/
tmp/

# Claude Code
.claude/
client folder for hub-system/hub-system.zip
dump.rdb

# Compiled Vite config. `vite.config.ts` is the source of truth, but Vite resolves
# vite.config.js BEFORE vite.config.ts — a committed build artifact silently shadows
# the real config and every later edit to the .ts becomes a no-op.
# Transient entry written by client/scripts/check-shared.mjs; removed on exit,
# listed here so a crashed run cannot leave it committable.
client/.shared-probe.generated.js

client/vite.config.js
client/vite.config.d.ts
platform-console/vite.config.js
platform-console/vite.config.d.ts
