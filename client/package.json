{
  "name": "praxis-ls-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Praxis LS frontend — React 18 + Vite + TypeScript (PWA). Tenant white-label app + (proposed) platform console.",
  "//engines": "Mirrors the root package.json and .nvmrc. The client is linted, tested and built on Node 20 in CI and in the Docker image, so a dev tree on a newer Node can silently accept a dependency that CI cannot run — exactly how jsdom@30 (which needs undici@8 / Node >=22.19) got in and broke the frontend job. Declaring it here makes npm emit EBADENGINE locally instead.",
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 112",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:motion": "node scripts/check-motion.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:palette": "node scripts/check-palette.mjs",
    "check:shared": "node scripts/check-shared.mjs",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "workbench": "ladle serve",
    "workbench:build": "ladle build",
    "test:e2e": "playwright test",
    "new:screen": "node scripts/new-screen.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "prove:gates": "node scripts/prove-gates.mjs",
    "e2e:install": "playwright install --with-deps chromium",
    "check:schemas": "node scripts/check-schemas.mjs"
  },
  "dependencies": {
    "@fontsource-variable/cascadia-code": "^5.3.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/lora": "^5.3.0",
    "@fontsource-variable/merriweather": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource-variable/noto-sans": "^5.3.0",
    "@fontsource-variable/open-sans": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource-variable/public-sans": "^5.3.0",
    "@fontsource-variable/roboto": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "@fontsource-variable/work-sans": "^5.3.0",
    "@fontsource/lato": "^5.3.0",
    "@hookform/resolvers": "^5.7.1",
    "@praxis/shared": "file:../packages/shared",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-query": "^5.101.4",
    "clsx": "^2.1.1",
    "pdfjs-dist": "^4.10.38",
    "praxis-ls": "file:..",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.84.0",
    "react-router-dom": "^6.26.2",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "^2.5.4",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@ladle/react": "^5.1.1",
    "@playwright/test": "1.56.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^4.3.2",
    "@vitest/ui": "^3.2.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.12.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.12",
    "globals": "^15.9.0",
    "jest-axe": "^11.0.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.8.0",
    "vite": "^5.4.8",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^3.2.4"
  }
}
