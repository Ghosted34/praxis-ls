# praxis-ls environment template.
#
# Copy to .env and fill in. The values below are tuned for a LOCAL run
# (`npm run dev`): localhost hosts, dev NODE_ENV, fixed dev secrets. For Docker
# (`docker compose up`) you do NOT edit this file — docker-compose.yml overrides
# the host-specific vars (DB_HOST=postgres, REDIS_URL=redis://redis:6379,
# NODE_ENV=production) in its `environment:` block. One .env serves both.
#
# src/config/env.js is the authoritative schema (Zod) with every var + default.
# When in doubt, read that file — not this template.

# ---- Core ----
# Local dev = development (also drives each log line's "env"). Docker sets
# production via compose. Never commit production here.
NODE_ENV=development
APP_BASE_DOMAIN=praxisls.com          # tenants resolve as <tenant>.praxisls.com
APP_NAME=praxisls-backend
PORT=8080
# Dedicated host for the Praxis-side Platform Console (Root-Admin UI). The console
# is served ONLY on this host (at its root); tenant hosts never serve it. Empty =
# not served by the api (use the console's Vite dev server locally). See §5b.
# e.g. admin.praxisls.com
PLATFORM_CONSOLE_HOST=

# Serve the stranger-facing app (public-web/) on the TENANT host, at /public/*
# and /portal/* — the marketing site, shipment tracking, published case notes,
# careers, shared proposals, and the external portal for clients, investors and
# auditors. Accepts 1|true|yes|on.
#
# OFF by default, and deliberately: this mount also takes over paths the tenant
# app already answers — /track, /portfolio, /careers and /client-portal — and
# redirects them to the new prefixes. A deployment that builds public-web by
# accident must not silently move those entry points out from under the ERP in
# the same release that was supposed to be a schema migration. One variable,
# set on purpose, is the switch. Turning it off again restores the ERP's own
# versions of those pages immediately; no data or schema is involved either way.
#
# The container also has to be BUILT with the app present (see the publicwebbuild
# stage in the Dockerfile) — the server checks for public-web/dist/index.html and
# stays quiet if it is missing, so setting this on an image built without it does
# nothing at all rather than failing loudly.
SERVE_PUBLIC_WEB=false
# A tenant's OWN domain is not configured here — it is a row in
# platform.subdomain with surface='public', set from the platform console.
# See migrations/platform/0103_subdomain_surface.sql for why it is data
# rather than configuration.


# ---- PostgreSQL (the PLATFORM/registry DB the app boots against) ----
# One DB per tenant is created by provisioning; these are the platform creds.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=praxis_platform
DB_USER=postgres
DB_PASSWORD=changeme                  # match your local Postgres (docker: DB_PASSWORD)
DB_PLATFORM_SCHEMA=platform
# Provisioning uses a superuser to CREATE DATABASE per tenant:
TENANT_DB_SUPERUSER=postgres
TENANT_DB_SUPERUSER_PASSWORD=changeme
DEV_TENANT_SLUG=

# ---- Redis / queue ----
# LOCAL value. Docker overrides this to redis://redis:6379 via compose — do NOT
# put the docker hostname here or `npm run dev` fails with ENOTFOUND redis.
REDIS_URL=redis://localhost:6379

# SEC-L2. Redis was unauthenticated, mitigated only by a loopback port binding —
# one compose edit away from not being a mitigation. Compose now starts Redis
# with `--requirepass "$REDIS_PASSWORD"` and REFUSES TO START if this is unset,
# because `--requirepass ""` is a no-op that looks configured and authenticates
# nothing.
#
# Set BOTH: this variable, and the same secret inside REDIS_URL —
#   REDIS_PASSWORD=<secret>
#   REDIS_URL=redis://:<secret>@redis:6379
# A password on the server with no password in the URL fails closed (NOAUTH on
# every command), which is the safe direction but is a confusing outage; a
# password in the URL and none on the server silently authenticates nothing.
REDIS_PASSWORD=__set_me__

# ---- Auth / crypto ----
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
SESSION_INACTIVITY_MIN=30             # refresh is rejected after this many idle minutes
# AES-256-GCM key for secrets-at-rest (2FA TOTP secrets, vendor keys). MUST be
# 64 hex chars (32 bytes). A fixed dev default is baked into env.js if omitted,
# but generate a real one for anything past a laptop: `openssl rand -hex 32`.
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ---- AI providers (ROTATE the discovery keys before first use) ----
DEEPSEEK_API_KEY=__rotate_me__        # reasoning / agentic assistant (primary)
GEMINI_API_KEY=__rotate_me__          # content + document vision (fallback)
GROQ_API_KEY=__rotate_me__            # voice-to-text
OPENAI_API_KEY=__rotate_me__          # embeddings (pgvector), text-embedding-3-small
AI_MONTHLY_CAP_XAF=0                  # 0 = uncapped; per-feature caps enforced in code

# ---- FX ----
EXCHANGERATE_API_KEY=__rotate_me__    # exchangerate-api, USD base
FX_SYNC_CRON=0 0 * * *                # daily midnight (MOD-08)
MILESTONE_SLA_CRON=0 6,18 * * *       # milestone SLA scan, 06:00 + 18:00 (MOD-31); empty disables
QES_POLL_CRON=*/30 * * * *            # certified-signature poll backstop (§7.4); empty disables (lost webhooks stall chains)
QES_QUOTA_CRON=0 6 * * *              # certified-signature quota watch, daily 06:00 UTC (§7.5); empty disables
MILESTONE_SLA_TZ=Africa/Douala        # wall-clock tz the SLA cron is read in

# ---- Email / SMTP ----
# TWO configurations (see doc/EMAIL_TWO_CONFIGS.md):
#  1. SYSTEM emails (OTP / invites / invoices / notifications): per-tenant
#     senders configured in Settings (email_identity / email.default). When a
#     tenant has NOT configured their own mail, these fall back to a Praxis
#     sender (no-reply@praxisls.com / support@praxisls.com) sent through the
#     deploy-wide SMTP below — configured + live-tested in the Platform Console
#     (Integrations → Mail fallback), stored in the platform `mail.fallback`
#     setting. The env vars below are a LAST-RESORT default for that fallback.
#  2. MAILBOX (each user's company-domain professional email, inbound +
#     outbound): connect via IMAP/SMTP or Microsoft/Google OAuth in the Mail UI
#     (email_connection) — independent of the system-email config above.
SMTP_HOST=__host__
SMTP_PORT=587                         # 587 STARTTLS or 465 SSL
SMTP_USER=__user__
SMTP_PASS=__rotate_me__
MAIL_FALLBACK_DOMAIN=praxisls.com
MAIL_DEFAULT_FROM=no-reply@praxisls.com
MAIL_SUPPORT_FROM=support@praxisls.com
MAIL_FALLBACK_FROM_NAME=Praxis
# Smart Mail programme (PR-2+). Defaults match src/config/env.js.
MAIL_DELIVERABILITY_INTERVAL_MS=86400000
MAIL_RBL_HOSTS=zen.spamhaus.org,bl.spamcop.net,b.barracudacentral.org
MAIL_SECURE_LINK_DAYS=7
MAIL_SLA_SWEEP_INTERVAL_MS=300000
MAIL_AI_MONTHLY_CAP_XAF=0

# ---- Storage (abstracted; local disk now, S3-compatible later) ----
STORAGE_DRIVER=local                  # local | s3
STORAGE_LOCAL_PATH=./data/vault
# e.g. Hetzner/Backblaze/Wasabi/MinIO (non-AWS)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ---- PDF ----
# Local: point at your Chromium/Chrome. Docker installs it at /usr/bin/chromium.
PUPPETEER_EXECUTABLE_PATH=

# ============================================================================
# Kaizen ops — INFRASTRUCTURE_PLAN §3 (health, backup, uptime, maintenance)
# ============================================================================
# Everything below has a working default. The two that MUST be set for the
# subsystem to be worth anything are ALERT_WEBHOOK_URL (or ALERT_EMAIL) and the
# offsite backup destination — without them the jobs run, record their results,
# and tell nobody.

# ---- Alerting (WS-ER1) ----
# The app warns at boot when no destination is set. That warning is the whole
# alerting system until one of these is filled in: a failed backup, a failed
# restore drill and a RED tenant all resolve to "page", and a page with nowhere
# to go is a log line.
# Slack/Teams/Discord incoming webhook
ALERT_WEBHOOK_URL=
# An email address, IN ADDITION to the webhook — alerts go to every destination
# set, not the first that works, because the two fail independently. Sent
# through the system mail sender, so Integrations -> Mail fallback must be
# configured or nothing leaves. Prefer the console: Integrations -> Ops alerts.
ALERT_EMAIL=
# Optional second destination for `page` severity only, so a fatal can reach
# somewhere noisier than the daily-notice channel. Unset = pages fall back to
# ALERT_WEBHOOK_URL — a misconfiguration must degrade to "too noisy", never to
# "silent".
ALERT_WEBHOOK_PAGE_URL=
# How often ops state is evaluated for alerting. Much less frequent than
# collection on purpose: measure often, notify rarely. A channel that repeats
# the same RED tenant every five minutes is a channel people mute.
OPS_ALERT_INTERVAL_MS=1800000         # 30 min

# ---- Fleet health (WS-H1 / WS-H2) ----
# The three AMBER thresholds below are vault-first (Platform Console → ops
# tuning); env is the fallback. TENANT_HEALTH_INTERVAL_MS is NOT — it is read
# once when the worker registers its repeating jobs, so a console change could
# not take effect until a restart.
TENANT_HEALTH_INTERVAL_MS=300000      # 5 min; 0 disables the per-tenant sweep
HEALTH_JOB_FAILURE_AMBER=5            # failed jobs in 24h before AMBER
HEALTH_ERROR_AMBER=50                 # errors in 24h before AMBER
HEALTH_LIVENESS_SLOW_MS=2000          # synthetic tenant read slower than this = AMBER
# The two capacity thresholds (pool utilisation %, pooler max-wait ms) are
# deliberately NOT listed here. They default at the call site, so absence is the
# working configuration and no deployment has to set them. Tune them in Platform
# Console → ops.tuning if the defaults prove wrong; the env keys still exist as
# an override but shipping them in this template only invites a typo that fails
# boot for a threshold nobody meant to change.

# ---- Backups (WS-B1 / D4 / D6) — FALLBACK ONLY ----
# These now live in Platform Console → Integrations → Backup storage, encrypted,
# with a Test that writes and reads back a real probe object. Resolution is
# vault → env, so the values below are only read on a deployment that has not
# been configured yet. Prefer the console: rotating a bucket key should not need
# a redeploy.
# D6: the offsite bucket should live in a DIFFERENT provider/account from
# primary storage, so one compromised credential cannot erase both the data and
# its backups. Keep the encryption key out of reach of the app credential.
BACKUP_DRIVER=local                   # local | s3
BACKUP_LOCAL_PATH=./data/backups
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_REGION=us-east-1
BACKUP_S3_FORCE_PATH_STYLE=true
# D4 retention: 30 daily + 12 weekly.
BACKUP_RETAIN_DAILY_DAYS=30
BACKUP_RETAIN_WEEKLY_WEEKS=12
BACKUP_CRON=0 1 * * *                 # nightly 01:00
# pg_dump/pg_restore must be present and NOT older than the server. On Windows
# typically C:\Program Files\PostgreSQL\<version>\bin\pg_dump.exe
PG_DUMP_BIN=pg_dump
PG_RESTORE_BIN=pg_restore

# ---- Restore drills (WS-B3) ----
# RESTORE_RTO_TARGET_SECONDS is vault-first. The cron and the database prefix are
# env-only: the first is read at worker startup, the second is a safety
# invariant the restore path refuses to write outside of.
# The drill is what turns a dump into a backup. It restores into a throwaway
# database, checks the data came back, records the MEASURED time to restore,
# then drops the copy. Monthly by default.
RESTORE_DRILL_CRON=0 4 1 * *          # 04:00 on the 1st
RESTORE_DRILL_DB_PREFIX=praxis_drill_ # restore refuses any target without this
RESTORE_RTO_TARGET_SECONDS=3600       # D4: RTO <= 1h per tenant

# ---- Uptime (WS-U1) ----
# Path, scheme, timeout and retention are vault-first; env is the fallback.
# UPTIME_PROBE_INTERVAL_MS stays env-only: it is the DENOMINATOR of the
# availability figure, so changing it casually would redefine every historical
# percentage.
# The interval is also the DENOMINATOR of the availability figure — a missing
# sample counts as downtime — so changing it changes what past percentages mean.
UPTIME_PROBE_INTERVAL_MS=300000       # 5 min
UPTIME_PROBE_TIMEOUT_MS=10000
UPTIME_PROBE_PATH=/api/health/ready
UPTIME_PROBE_SCHEME=https
UPTIME_RETAIN_DAYS=90                 # longer than health: feeds monthly reports
# The platform/admin host, probed alongside the tenant subdomains.
# Defaults to PLATFORM_CONSOLE_HOST, which is the same host on every deployment
# so far — set this ONLY if the host you want probed differs from the one the
# console is served on. Leaving both empty means the admin host is not probed
# at all, which is how it went unmonitored: two names for one value is one name
# too many.
PLATFORM_HOST=
# ── Which prober runs. These two are a PAIR; exactly one probing arrangement
# should be active, and deploy.sh enforces that rather than trusting it.
#
# UPTIME_PROBE_IN_PROCESS=true  → the API samples on its own schedule. Cannot
#   observe the API being down, which is the failure WS-U1 exists for. Fine as
#   a starting point, and it is the default so a fresh deploy measures SOMETHING.
#
# To switch on the external prober, set this to false. deploy.sh then rolls the
# `uptime-probe` container; while it is true, deploy REFUSES to start that
# container, because running both samples every host twice per interval and
# inflates the availability figure on the status page and monthly report.
UPTIME_PROBE_IN_PROCESS=true

# Whether the `uptime-probe` container runs in THIS compose stack (read by
# scripts/deploy.sh). Set false when a prober runs on another host or region —
# which is better, since a probe sharing a host with its target cannot see the
# host die. Setting it false also STOPS a probe already running here, so the
# flag and reality cannot drift apart.
UPTIME_PROBE_IN_COMPOSE=true

# ============================================================================
# Scaling — INFRASTRUCTURE_PLAN §5
# ============================================================================

# ---- Per-tenant DB credentials (WS-S2) ----
# Tenants are already separate databases, but every pool authenticated with the
# same shared DB_PASSWORD — separation in structure, not in access. Each tenant
# now gets its own role; resolution is vault -> shared fallback, so this is
# inert until a tenant is backfilled:
#   npm run db:creds:backfill        then      npm run db:creds:verify
# `verify` is the negative test — it proves one tenant's credential opens no
# other tenant's database, and exits non-zero if it does.
#
# INCIDENT 2026-08-12. The credential lookup reads the PLATFORM database, and it
# used to do so inline, on pool creation, every 60 seconds per tenant, while
# holding the registry's in-flight guard. When the ops sweeps saturated the
# platform DB those lookups queued past the pool acquire timeout and every tenant
# login failed. The cache is now stale-while-revalidate and the cold read is
# bounded, so a slow secret store costs isolation for one pool creation instead
# of costing availability.
TENANT_DB_CRED_TTL_MS=3600000         # refresh interval; rotation is immediate via invalidate()
TENANT_DB_CRED_TIMEOUT_MS=500         # max a COLD lookup may delay a tenant connection

# ---- Connection budget (INCIDENT 2026-08-12) ----
# The arithmetic nobody had done: DB_POOL_MAX + (TENANT_POOL_MAX x
# TENANT_POOL_CACHE_MAX), multiplied by the number of processes sharing one
# Postgres, versus what Postgres will actually accept. It was ~6x over, invisible
# until the health collector started waking every tenant every five minutes.
#
# Checked at boot now. `warn` logs loudly; `enforce` refuses to start; `off`
# skips. With a pooler in front (TENANT_DB_POOLER_HOST) the app ceiling may
# exceed max_connections by design, so the check reports instead of judging.
DB_BUDGET_CHECK=warn                  # off | warn | enforce
DB_BUDGET_PROCESSES=3                 # api + api-standby + worker
DB_BUDGET_HEADROOM_PCT=20             # left free for migrations, pg_dump, drills, psql
# Background work (health sweeps, uptime, entitlement, backup) draws from its own
# small platform pool so it can never starve a login. Sharing one pool is what
# turned a busy health collector into a tenant outage on 2026-08-12.
OPS_POOL_MAX=4
DB_CONNECT_TIMEOUT_MS=10000
# Read by docker-compose, not the app: Postgres's own limit. The upstream default
# is 100, which is what the incident ran into.
#   POSTGRES_MAX_CONNECTIONS          (default 300)

# ---- Tenant smoke test (INCIDENT 2026-08-12) ----
# deploy.sh's readiness gate probes the PLATFORM database and Redis, so it passed
# for the entire outage while every tenant login timed out. A health check that
# never touches a tenant cannot see a tenant outage. Set this to a real tenant
# slug and the deploy additionally opens that tenant's pool and runs a query,
# failing the deploy on the same timeout a user would hit.
# Unset = skipped with a warning.
#
# Named rather than assigned: deploy.sh reads it, the application does not, and
# assigning it here would make the env-template check claim otherwise.
#   TENANT_SMOKE_SLUG               e.g. smartls  (empty = smoke test skipped)

# ---- PgBouncer (WS-S1 / D3) ----
# Nothing routes through the pooler until TENANT_DB_POOLER_HOST is set, so the
# container can be brought up safely first and the switch reverted just as fast.
# Run `npm run db:pgbouncer-auth` ONCE before pointing anything at it — it
# creates the lookup role and function auth_query needs. Without that step every
# pooled connection fails auth in a way that looks like a Postgres outage.
#
# Migrations, provisioning and pg_dump keep connecting to Postgres DIRECTLY;
# they need session state transaction pooling does not preserve.
# CUTOVER ORDER — the pooler is READY but must be switched on deliberately:
#
#   1. npm run db:creds:backfill      per-tenant roles; this also applies
#      npm run db:creds:verify        `ALTER ROLE ... SET search_path`, which is
#                                     what makes a pooled connection land on the
#                                     right schema. A tenant without it is served
#                                     through a transaction-pinned fallback, so
#                                     nothing breaks — it is just slower.
#   2. npm run db:pgbouncer-auth      lookup role + get_auth function
#      npm run db:pgbouncer-auth:check
#   3. raise PGBOUNCER_MAX_DB_CONNECTIONS (80 / default_pool_size 5 = 16 active
#      tenants, far under WS-S1's ">100 concurrent tenants" target)
#   4. set TENANT_DB_POOLER_HOST in a deploy that changes NOTHING ELSE, so
#      reverting is clearing one variable.
#
# The app stops sending `options=-c search_path=...` when this is set — PgBouncer
# rejects that startup parameter, and ignoring it is worse than rejecting it
# (the connection succeeds and the setting is silently dropped).
# e.g. pgbouncer  (empty = direct to Postgres)
TENANT_DB_POOLER_HOST=
# The port is only consulted when the HOST above is set. It shipped as 6432
# beside an empty host until 2026-08-12, when a deployment that copied this
# template sent every tenant connection to the real Postgres host on the
# POOLER's port and got ECONNREFUSED. Left empty; registry.service.js
# defaults it to 6432 when the host is set, so the pair cannot half-apply.
TENANT_DB_POOLER_PORT=
PGBOUNCER_AUTH_USER=pgbouncer
# YOU choose this value — nothing generates it and there is nowhere to look it
# up. `db:pgbouncer-auth` READS it from here and writes it to the Postgres role,
# so .env is the source of truth. Generate one with: openssl rand -hex 24
PGBOUNCER_AUTH_PASSWORD=__rotate_me__
#
# POOL SIZING — read by docker-compose and the pgbouncer entrypoint ONLY, never
# by this application, so they are named here rather than assigned. Setting them
# in .env still works (compose substitutes from it); they are named rather than
# assigned because the env-template check would otherwise claim the app reads
# them, which is how a template turns into folklore.
#
#   PGBOUNCER_MAX_CLIENT_CONN      (default 1000) app-side connection ceiling
#   PGBOUNCER_DEFAULT_POOL_SIZE    (default 5)    server conns per tenant DB
#   PGBOUNCER_RESERVE_POOL_SIZE    (default 2)
#   PGBOUNCER_MAX_DB_CONNECTIONS   (default 80)   hard stop across every pool
#
# One database PER TENANT, so default_pool_size multiplies by active tenants:
# default_pool_size x active tenants must stay under Postgres max_connections
# with headroom for migrations, backups and psql.

# ---- Alert destination: now set in the console, not here ----
# WS-ER1 moved the alert channel into the platform settings vault, written from
# Platform Console → Integrations → Ops alerts, where it can also be TESTED (the
# test sends a real message — a webhook pasted wrong looks identical to a
# working one until the night it matters). Resolution is vault → env, so the
# two keys above (ALERT_WEBHOOK_URL / ALERT_WEBHOOK_PAGE_URL) remain a valid
# fallback for a fresh deploy that has not been configured yet. Prefer the
# console: repointing a webhook at 3am should not need a redeploy.

# ---- WAL archiving / point-in-time recovery (WS-B1 layer 2, D4) ----
# Nightly dumps alone mean a 24-hour recovery point: lose the host at 23:00 and
# you lose the day. Continuous WAL archiving brings that down to minutes, and
# because Postgres here is self-run on a VPS, it IS available — D4's "<= 5 min
# where PITR is available" applies.
#
# TWO switches, and BOTH are needed:
#   WAL_ARCHIVE_MODE=on      tells Postgres to archive (docker-compose)
#   WAL_ARCHIVE_ENABLED=true tells the app to CHECK the archive and alert
# Turning on only the second reports an empty archive as broken (correctly).
# Turning on only the first archives with nobody watching, which is how a dead
# archiver goes unnoticed until the data volume fills.
#
# archive_command runs INSIDE the postgres container and uploads through the
# same storage driver as the dumps, so BACKUP_* above governs where WAL lands.
#
# Enabling this also needs the OPT-IN compose overlay, which builds a postgres
# image carrying the node runtime archive_command requires:
#
#   docker compose -f docker-compose.yml -f docker-compose.wal.yml up -d postgres
#
# It is deliberately NOT in the base compose file — that would rebuild postgres
# on every deploy for a feature that is off by default. See
# docker-compose.wal.yml for the full procedure.
WAL_ARCHIVE_MODE=off                  # on | off  — Postgres archive_mode
WAL_ARCHIVE_ENABLED=false             # app-side health check + alerting
WAL_ARCHIVE_PREFIX=wal                # key prefix in the backup bucket
# How stale the archive may get before it is called broken. Must exceed
# archive_timeout (300s) with room, or a quiet database looks like a dead
# archiver.
WAL_MAX_LAG_MINUTES=15
