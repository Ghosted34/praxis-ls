# public-web — local development
#
# The app is tenant-scoped: every call goes to /api/tenant/… and the backend
# resolves WHICH tenant from the request's Host header. That is what these two
# variables exist for — they only affect `npm run dev`. In a production build
# there is nothing to set: the browser's own Host does the work.

# Where the Node API is. Default matches doc/SETUP.md (and client/.env.example).
VITE_API_TARGET=http://localhost:8080

# The tenant whose data this dev server should look like. Must be a provisioned
# slug; `smartls` is what scripts/db/reset:local creates.
VITE_TENANT_HOST=smartls.praxisls.com
