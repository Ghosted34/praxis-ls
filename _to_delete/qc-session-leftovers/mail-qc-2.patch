+    const path = require("path");
+    const src = fs.readFileSync(path.resolve(__dirname, "../../src/modules/mail/mail/thread.service.js"), "utf8");
+    expect(src).toMatch(/markAsRead[\s\S]{0,80}"serverFlags"/);
