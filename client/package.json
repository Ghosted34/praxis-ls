{
  "name": "praxis-ls-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Praxis LS frontend — React 18 + Vite + TypeScript (PWA). Tenant white-label app + (proposed) platform console.",
  "//engines": "Mirrors the root package.json and .nvmrc. The client is linted, tested and built on Node 20 in CI and in the Docker image, so a dev tree on a newer Node can silently accept a dependency that CI cannot run — exactly how jsdom@30 (which needs undici@8 / Node >=22.19) got in and broke the frontend job. Declaring it here makes npm emit EBADENGINE locally instead.",
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "check:contrast": "node scripts/check-contrast.mjs",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tanstack/react-query": "^5.101.4",
    "clsx": "^2.1.1",
    "praxis-ls": "file:..",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "^2.5.4",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^4.3.2",
    "@vitest/ui": "^4.1.10",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.12.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.12",
    "globals": "^15.9.0",
    "jest-axe": "^11.0.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.8.0",
    "vite": "^5.4.8",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^4.1.10"
  }
}
